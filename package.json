  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev": "vite",
    "lint": "eslint .",
    "format": "prettier --write .",
    "rename-jsx": "find ./src -type f -name '*.js' -not -name '*.jsx' -not -name '*.ejs' -exec bash -c 'grep -l -E \"</|/>\" \"$0\"' {} \\; -exec bash -c 'mv \"$0\" \"${0%.js}.jsx\"' {} \\;",
